<?xml version="1.0" encoding="utf-8"?>
<!--
  Production (release) network policy: HTTPS only for any real backend host.

  The domain-config block below is a DEV CONVENIENCE ONLY. It lets a
  release build (flutter run in release mode) still reach a local dev
  server over http://localhost:4000 or 10.0.2.2:4000. It is scoped to
  loopback / emulator-host addresses, which can never be a real production
  endpoint.

  IMPORTANT: remove the domain-config block before building a release
  APK/AAB that you actually distribute.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- DEV ONLY. Remove before distributing (and put the real backend
         behind TLS). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">10.0.3.2</domain>
        <!-- Self-hosted dev backend (http, no TLS yet). -->
        <domain includeSubdomains="true">185.239.2.7</domain>
    </domain-config>
</network-security-config>
