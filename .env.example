# Base URL of the self-hosted EsmVaFamilYar backend (Socket.io server).
# Classic AVD NAT networking (most emulators): http://10.0.2.2:4000
# If the emulator uses its own virtual Wi-Fi network (10.0.2.2 unreachable —
# check with `adb shell ip route`), use `adb reverse tcp:4000 tcp:4000` and
# point the app at http://localhost:4000 instead.
# Physical device on same LAN: http://<your-computer-lan-ip>:4000
# Production: https://your-domain.example.com (behind TLS reverse proxy)
SERVER_URL=http://185.239.2.7:4000

# Cafe Bazaar RSA public key and Tapsell app key/zone id are fetched from
# the backend at startup (GET /config/client), not read from here — set
# them in the server's .env (BAZAAR_RSA_PUBLIC_KEY, TAPSELL_APP_KEY,
# TAPSELL_REWARDED_ZONE_ID) instead.
